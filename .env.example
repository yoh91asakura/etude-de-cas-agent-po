# Copier ce fichier en .env et le remplir. Le fichier .env n'est jamais versionné.

# Obligatoire : clé d'API Anthropic, utilisée par la passerelle LLM du socle (LiteLLM).
ANTHROPIC_API_KEY=

# Socle. Les valeurs par défaut du compose conviennent à un poste local, pas à un environnement partagé.
# Clé maître de la passerelle : sert seulement à administrer (créer les clés de projet), jamais à l'agent.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=
# Clé virtuelle du projet « agent PO » : écrite ici par node socle/litellm/creer-cle-projet.mjs.
LITELLM_CLE_PROJET=

# Optionnel, pour le développement et les évaluations : une clé OpenRouter à la place d'une clé Anthropic.
# Les appels passent alors par OpenRouter, épinglés sur le fournisseur Anthropic (jamais Bedrock ni Vertex).
# La cible reste la passerelle du socle.
# Ne pas la mettre dans ANTHROPIC_API_KEY : Docker Compose transmet cette variable à la passerelle LiteLLM, qui l'enverrait à Anthropic.
OPENROUTER_API_KEY=
# Optionnel : impose un seul modèle à toutes les étapes, pour un test (claude-haiku-5-5 coûte le moins).
# Vide, chaque étape prend son modèle par défaut : Sonnet pour lire les feedbacks, Haiku pour les jugements courts,
# Opus pour la revue de fond et le juge des stories.
LLM_MODELE=
# Optionnel : régler une étape à part, prioritaire sur le reste, par exemple « impact=claude-opus-5-5:high,revue=:medium ».
LLM_ETAPES=

# Optionnel : « faux » pour tourner sans clé (faux fournisseur, plomberie seule).
LLM_FOURNISSEUR=
# Optionnel : modèle de l'étape d'extraction, pour mesurer un modèle plus léger (ex. claude-haiku-5-5).
LLM_MODELE_EXTRACTION=

# Optionnel : Telegram. Sans ces jetons, les questions au PO passent par la boîte de propositions de l'application.
# Bot du PO, créé avec @BotFather.
TELEGRAM_PO_BOT_TOKEN=
# Identifiants Telegram autorisés à parler au bot du PO, séparés par des virgules.
TELEGRAM_ALLOWED_USERS=
# Bot « support client » de la startup fictive, utilisé pour l'escalade en direct pendant la démo.
TELEGRAM_SUPPORT_BOT_TOKEN=
# Compte de la startup fictive au nom duquel écrit le « client » du bot support (par défaut C237, celui de l'escalade).
TELEGRAM_SUPPORT_COMPTE_ID=C237

# Optionnel : export des stories validées vers Jira Cloud (après décision du PO).
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJET=
# Type de ticket créé (par défaut Story).
JIRA_TYPE_TICKET=
